# Copy to .env next to compose.yaml (chmod 600). Empty values use the defaults in docker-compose.yml.

# The DSM user the backend runs as (see README_DOCKER.md); default 999:999
PUID=999
PGID=999
# Port on the NAS
PORT=8085
# Signs the logins: openssl rand -hex 32
SECRET_KEY=
# First parent's PIN on an empty database (4 digits); empty = random, printed once in the backend log
INITIAL_ADMIN_PIN=
# de or en: language of people who haven't picked one
DEFAULT_LANGUAGE=de
TZ=Europe/Zurich

# Recipe mails (README_DOCKER.md, "Recipe mails"): openssl rand -hex 32; empty = off
INBOUND_SECRET=
# AI (README_DOCKER.md, "AI"): empty = off
INFOMANIAK_AI_TOKEN=
INFOMANIAK_AI_PRODUCT_ID=
# Default google/gemma-4-31B-it
AI_MODEL=
# AI calls per person and hour (default 30; 0 = off)
AI_CALLS_PER_HOUR=
